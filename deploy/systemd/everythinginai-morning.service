[Unit]
Description=EverythinInAI — Morning Schedule Announce (8 AM IST daily)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/everythinginai-unified
EnvironmentFile=/home/ubuntu/everythinginai-unified/.env
ExecStart=/usr/bin/node /home/ubuntu/everythinginai-unified/avatar/scheduler/morning_announce.js
StandardOutput=append:/home/ubuntu/everythinginai-unified/logs/morning.log
StandardError=append:/home/ubuntu/everythinginai-unified/logs/morning.log
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
