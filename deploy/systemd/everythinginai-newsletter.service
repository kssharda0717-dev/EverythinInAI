[Unit]
Description=EverythinInAI — Daily Newsletter Digest (8:00 AM IST)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/everythinginai-unified
EnvironmentFile=/home/ubuntu/everythinginai-unified/.env
ExecStart=/usr/bin/node /home/ubuntu/everythinginai-unified/engine/observability/newsletter_digest.js
StandardOutput=append:/home/ubuntu/everythinginai-unified/logs/newsletter.log
StandardError=append:/home/ubuntu/everythinginai-unified/logs/newsletter.log
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
