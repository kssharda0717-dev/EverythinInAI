[Unit]
Description=EverythinInAI — Weekly Stats Reminder (Sunday 19:00 IST)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/everythinginai-unified
EnvironmentFile=/home/ubuntu/everythinginai-unified/.env
ExecStart=/usr/bin/node /home/ubuntu/everythinginai-unified/avatar/scheduler/weekly_stats_announcer.js
StandardOutput=append:/home/ubuntu/everythinginai-unified/logs/weekly_stats.log
StandardError=append:/home/ubuntu/everythinginai-unified/logs/weekly_stats.log
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
