# Frontend (browser-safe — VITE_ prefix exposes to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Backend (server-only )
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BATCH_SIZE=8

# Engine config
ENGINE_MODE=incremental
INCREMENTAL_HOURS=6
MAX_ITEMS_PER_RUN=300

# Optional: GitHub committer (leave empty to skip )
GITHUB_TOKEN=
GITHUB_REPO=

# Engine API server (only if using the standalone HTTP API)
ENGINE_API_PORT=3847
ENGINE_API_SECRET=change-me-to-a-random-string
